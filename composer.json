{
    "name": "tx-admin/schema-compare",
    "description": "Database schema structure comparison toolkit (ClickHouse / MySQL). Framework-agnostic core with Hyperf integration.",
    "license": "MIT",
    "authors": [
        {
            "name": "angryshan",
            "email": "angryshan@qq.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "hyperf/db": "使用 HyperfAdapter（PDO）时需要",
        "hyperf/db-connection": "使用 HyperfORMAdapter（ORM）时需要",
        "topthink/framework": "使用 ThinkPHPAdapter 时需要"
    },
    "autoload": {
        "psr-4": {
            "TxAdmin\\SchemaCompare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TxAdmin\\SchemaCompare\\Test\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix src/",
        "cs-check": "php-cs-fixer fix src/ --dry-run --diff"
    },
    "extra": {
        "hyperf": {
            "config": "TxAdmin\\SchemaCompare\\ConfigProvider"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
